{
  "name": "server",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && tap --ts test/**/*.test.ts",
    "build:ts": "tsc",
    "dev": "NODE_ENV=development tsc && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"tsc -w\" \" export NODE_ENV=development && fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js\"",
    "start": "NODE_ENV=production npm run build:ts && fastify start -l info dist/app.js"
  },
  "keywords": [],
  "author": "TorenIvan",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^5.7.1",
    "@fastify/cookie": "^8.3.0",
    "@fastify/cors": "^8.2.0",
    "@fastify/helmet": "^10.1.0",
    "@fastify/multipart": "^7.6.0",
    "@fastify/oauth2": "^7.5.0",
    "@fastify/sensible": "^5.2.0",
    "@sinclair/typebox": "^0.23.5",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/nodemailer": "^6.4.7",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.2",
    "fastify": "^4.24.3",
    "fastify-cli": "^5.9.0",
    "fastify-overview": "^3.3.0",
    "fastify-plugin": "^4.5.0",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^4.13.0",
    "nodemailer": "^6.9.1",
    "path": "^0.12.7",
    "resend": "^6.0.1",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "^17.0.8",
    "@types/tap": "^15.0.7",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "concurrently": "^7.0.0",
    "eslint": "^8.52.0",
    "eslint-plugin-react": "^7.33.2",
    "fastify-tsconfig": "^1.0.1",
    "nodemon": "^2.0.15",
    "tap": "^16.3.3",
    "ts-node": "^10.4.0",
    "typescript": "^5.2.2"
  }
}
