{
  "name": "server",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build:ts": "tsc",
    "dev": "NODE_ENV=development tsc && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"tsc -w\" \" export NODE_ENV=development && fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js\"",
    "start": "NODE_ENV=production node dist/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [],
  "author": "TorenIvan",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/sensible": "6.0.7",
    "@fastify/static": "10.1.8",
    "@types/jsonwebtoken": "9.0.10",
    "axios": "1.20.0",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "fastify-cli": "8.0.3",
    "fastify-overview": "4.1.1",
    "fastify-plugin": "6.0.1",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.7.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "resend": "6.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "fastify-tsconfig": "3.0.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
